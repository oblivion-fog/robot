<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <!--包含common_properties.xacro-->
    <xacro:include filename="common_properties.xacro" />
<!--属性-->
    <xacro:property name="base_length" value="0.6" />
    <xacro:property name="base_width" value="0.4" />
    <xacro:property name="base_height" value="0.3" />
    <xacro:property name="wheel_radius" value="0.1" />
    <xacro:property name="wheel_length" value="0.05" />
    <xacro:property name="caster_wheel_radius" value="0.05" />
    <link name="base_footprint" />
    <link name="base_link" >
        <visual>
            <geometry>
            <!--size 单位：米 size 往两个上下左右前后六个方向扩展-->
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <!--origin 指定visual几何中心的偏移量(相对于base_footprint的坐标系) -->
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <xacro:box_inertia m="4.0" x="${base_length}" y="${base_width}" z="${base_height}" o_xyz="0 0 ${base_height/2.0}" o_rpy="0 0 0" />
        <!--碰撞属性-->
        <collision>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0" />
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
        </collision>
    </link>
    <!--宏-->
    <xacro:macro name="wheel" params="name">
        <link name="rear_${name}_link" >
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
                <material name="green" />
            </visual>
            <xacro:cylinder_inertia m="1.0" r="${wheel_radius}" h="${wheel_length}" o_xyz="0 0 0" o_rpy="${pi/2.0} 0 0" />
            <!--碰撞属性-->
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <sphere radius="${wheel_radius}" />
                </geometry>
            </collision>
        </link>
    </xacro:macro>
    <!--宏的调用-->
    <xacro:wheel name="right" />
    <xacro:wheel name="left" />

    <link name="caster_wheel_link" >
        <visual>
            <geometry>
                <sphere radius="${caster_wheel_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="green" />
        </visual>
        <xacro:sphere_inertia m="1.0" r="${caster_wheel_radius}" o_xyz="0 0 0" o_rpy="0 0 0" />
        <!--碰撞属性-->
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="${caster_wheel_radius}" />
            </geometry>
        </collision>
    </link>

    <joint name="base_joint" type="fixed" >
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0.1" rpy="0 0 0" />
    </joint>

    <joint name="base_rear_left_joint" type="continuous" >
        <parent link="base_link" />
        <child link="rear_left_link" />
        <origin xyz="${-base_length/4.0} ${base_width/2.0+wheel_length/2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>
    <joint name="base_rear_right_joint" type="continuous" >
        <parent link="base_link" />
        <child link="rear_right_link" />
        <origin xyz="${-base_length/4.0} ${-base_width/2.0-wheel_length/2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>
    <joint name="caster_wheel_joint" type="fixed" >
        <parent link="base_link" />
        <child link="caster_wheel_link" />
        <origin xyz="${base_length/4.0} 0 -0.05" rpy="0 0 0" />
    </joint>
    </robot>