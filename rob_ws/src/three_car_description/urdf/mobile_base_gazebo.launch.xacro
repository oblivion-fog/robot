<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <!--添加摩擦系数-->
    <gazebo reference="caster_wheel_link">
        <mul1 value="0.0" />
        <mul2 value="0.0" />
    </gazebo>
    
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive" >
            <left_joint>base_rear_left_joint</left_joint>
            <right_joint>base_rear_right_joint</right_joint>
            <wheel_separation>0.45</wheel_separation>
            <wheel_radius>0.1</wheel_radius>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <min_velocity>0.0</min_velocity>
            <min_angular_velocity>0.0</min_angular_velocity>    
        </plugin>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher" >
            <joint_name>base_rear_left_joint</joint_name>
            <joint_name>base_rear_right_joint</joint_name>  
        </plugin>
    </gazebo>
</robot>